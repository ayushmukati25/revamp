---
// Shell for the reserved root page (/). Client sites never use this — each
// client has its own Layout under src/clients/<client>/.
import './hub.css';

interface Props {
  title?: string;
}

const { title = 'Revamp — client sites' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
  </head>
  <body>
    <main class="hub">
      <slot />
    </main>
  </body>
</html>
