---
import './styles.css';
import Header from './Header.astro';
import Footer from './Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Digital Doctor Electronic Repairs | Manahawkin, NJ',
  description = 'Phone, tablet, laptop and console repair in Manahawkin, New Jersey. Most repairs take about 45 minutes, with a 60-day warranty and mail-in service.',
} = Astro.props;

// The 12C mark as a favicon, inlined so the project needs no file in public/.
const favicon =
  'data:image/svg+xml,' +
  encodeURIComponent(
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="-64 -40 536 596"><rect x="-64" y="-40" width="536" height="596" rx="110" fill="#E0402B"/><rect width="107" height="516" rx="18" fill="#EDE4DA"/><path fill="#5A1A1A" d="M147 18 Q147 0 165 0 C262 0 372 72 399 142 Q408 166 392 190 C346 262 270 342 190 342 L165 342 Q147 342 147 324 Z"/><path fill="#EDE4DA" stroke="#EDE4DA" stroke-width="16" stroke-linejoin="round" d="M182 389 L259 378 L330 506 L240 506 Z"/></svg>',
  );
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#140B0A" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=BBH+Bogle&family=IBM+Plex+Sans:wght@400;600&family=JetBrains+Mono:wght@400&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <script is:inline>
      // Opt in to scroll reveals only when the browser can run them and the
      // visitor hasn't asked for reduced motion; otherwise content shows as-is.
      if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion');
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      // Lenis smooth scrolling. Skipped for visitors who prefer reduced
      // motion, who keep the browser's native scroll.
      import Lenis from 'lenis';
      import 'lenis/dist/lenis.css';

      const lenis = matchMedia('(prefers-reduced-motion: reduce)').matches
        ? null
        : new Lenis({
            autoRaf: true,
            // Higher lerp = snappier catch-up. 0.115 is ~15% quicker than
            // Lenis's default of 0.1.
            lerp: 0.115,
          });

      // In-page links land each section's content just below the sticky
      // header. Open sections (no background of their own) start with a lot
      // of top padding, so we skip past it; panels like Warranty keep their
      // padding because it's part of the panel.
      const header = document.querySelector('.site-header');
      const GAP = 24;

      function scrollToSection(target) {
        const style = getComputedStyle(target);
        const isOpen = style.backgroundColor === 'rgba(0, 0, 0, 0)' || style.backgroundColor === 'transparent';
        const inset = isOpen ? parseFloat(style.paddingTop) : 0;
        const top =
          target.getBoundingClientRect().top + window.scrollY + inset - (header?.offsetHeight ?? 0) - GAP;
        if (lenis) lenis.scrollTo(top);
        else window.scrollTo({ top });
      }

      document.addEventListener('click', (event) => {
        const link = event.target.closest?.('a[href^="#"]');
        if (!link) return;
        const hash = link.getAttribute('href');
        const target = hash.length > 1 && document.getElementById(hash.slice(1));
        if (!target || !target.matches('section')) return;
        event.preventDefault();
        history.pushState(null, '', hash);
        scrollToSection(target);
      });
    </script>
    <script is:inline>
      if (document.documentElement.classList.contains('motion')) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                const el = e.target;
                el.classList.add('is-visible');
                io.unobserve(el);
                // Once it has settled, hand the element back to its normal
                // styles so the stagger delays don't slow later hovers.
                setTimeout(() => {
                  el.removeAttribute('data-reveal');
                  el.classList.remove('is-visible');
                }, 1200);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px' }
        );
        document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
